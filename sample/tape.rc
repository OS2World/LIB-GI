#include <os2.h>

DLGTEMPLATE 100
BEGIN
        DIALOG "Tape-Control", 100, 110, 68, 205, 93, WS_VISIBLE, FCF_TITLEBAR
        BEGIN
                CONTROL "#1", 101, 14, 68, 23, 14, WC_BUTTON, BS_PUSHBUTTON | BS_ICON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "#2", 102, 50, 68, 23, 14, WC_BUTTON, BS_PUSHBUTTON | BS_ICON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "#3", 103, 86, 68, 23, 14, WC_BUTTON, BS_PUSHBUTTON | BS_ICON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "", 105, 178, 68, 9, 10, WC_BUTTON, BS_AUTORADIOBUTTON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "File...", 106, 10, 25, 40, 14, WC_BUTTON, BS_PUSHBUTTON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "", 107, 66, 28, 124, 9, WC_ENTRYFIELD, ES_LEFT | ES_AUTOSCROLL | ES_MARGIN | 0x00000000L | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "End Program", 108, 124, 4, 64, 14, WC_BUTTON, BS_PUSHBUTTON | WS_VISIBLE | WS_GROUP | WS_TABSTOP
                CONTROL "Play", 109, 14, 54, 22, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
                CONTROL "Record", 110, 46, 54, 31, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
                CONTROL "Stop", 111, 87, 54, 42, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
                CONTROL "Counter", 112, 142, 54, 32, 8, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
                CONTROL "Sample", 113, 6, 50, 192, 36, WC_STATIC, SS_FGNDFRAME | WS_VISIBLE | WS_GROUP
                CONTROL "Sample", 114, 135, 66, 54, 14, WC_STATIC, SS_FGNDFRAME | WS_VISIBLE | WS_GROUP
                CONTROL "9999", 104, 140, 68, 31, 8, WC_STATIC, SS_TEXT | DT_RIGHT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
                CONTROL "Stop on Overplay", 115, 16, 4, 84, 10, WC_BUTTON, BS_AUTOCHECKBOX | WS_VISIBLE | WS_GROUP | WS_TABSTOP
        END

END






POINTER 1 "ptr1.ptr"


POINTER 2 "ptr2.ptr"

POINTER 3 "ptr3.ptr"
