FORMAT OS2 FLAT DLL INITINSTANCE
NAME KBD.DLL
OPTION MAP=OBJ\KBD.MAP
OPTION DESCRIPTION '@#OS2World:1.01#@KBD 1.01 - GI keyboard strategy by Roman Fischer (Open Watcom 2)'
OPTION MANYAUTODATA
OPTION STACK=32768
OPTION VERSION=2.0
EXPORT _GetDataSize.1=GETDATASIZE RESIDENT
EXPORT _InitializeDLL.2=INITIALIZEDLL RESIDENT
EXPORT _Name.3=NAME RESIDENT
EXPORT '@ConfigKey$qpuit1'.4=CONFIGKEY RESIDENT
EXPORT _ConfigDLL.5=CONFIGDLL RESIDENT
EXPORT _Threshold.6=THRESHOLD RESIDENT
EXPORT _Direction.7=DIRECTION RESIDENT
FILE OBJ\KBD.OBJ
LIBRARY CLIB3R.LIB
LIBRARY OS2386.LIB
