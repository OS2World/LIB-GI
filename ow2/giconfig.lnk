FORMAT OS2 FLAT PM
NAME GICONFIG.EXE
OPTION MAP=OBJ\GICONFIG.MAP
OPTION DESCRIPTION '@#OS2World:1.01#@GICONFIG 1.01 - GI configuration by Roman Fischer (Open Watcom 2)'
OPTION VERSION=2.0
IMPORT _error gi.1
IMPORT _numplayer gi.2
IMPORT _fip gi.3
IMPORT GIINITIALIZE gi.4
IMPORT INITFIP gi.6
IMPORT DELFIP gi.7
IMPORT SAVE gi.8
FILE OBJ\GICONFIG.OBJ
FILE OBJ\PMTHREAD.OBJ
FILE OBJ\ERROR.OBJ
FILE OBJ\THREAD.OBJ
LIBRARY PLIB3R.LIB
LIBRARY CLIB3R.LIB
LIBRARY OS2386.LIB
