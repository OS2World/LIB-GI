FORMAT OS2 FLAT DLL
NAME TAPEDEV.DLL
OPTION MAP=OBJ\TAPEDEV.MAP
OPTION DESCRIPTION '@#OS2World:1.01#@TAPEDEV 1.01 - GI tape strategy by Roman Fischer (Open Watcom 2)'
OPTION ONEAUTODATA
OPTION STACK=32768
OPTION VERSION=2.0
EXPORT _modeflag.1=_modeflag RESIDENT
EXPORT _stoponover.2=_stoponover RESIDENT
EXPORT _event.3=_event RESIDENT
EXPORT _filename.4=_filename RESIDENT
EXPORT _cfgpresent.5=_cfgpresent RESIDENT
EXPORT _globhwnd.6=_globhwnd RESIDENT
EXPORT _count.7=_count RESIDENT
EXPORT _GetDataSize.8=GETDATASIZE RESIDENT
EXPORT _InitializeDLL.9=INITIALIZEDLL RESIDENT
EXPORT _Name.10=NAME RESIDENT
EXPORT _ConfigDLL.11=CONFIGDLL RESIDENT
EXPORT _Threshold.12=THRESHOLD RESIDENT
EXPORT _Direction.13=DIRECTION RESIDENT
IMPORT GIGETDIRECTION gi.5
IMPORT GIGETTHRESHOLD gi.9
FILE OBJ\TAPEDEV.OBJ
LIBRARY CLIB3R.LIB
LIBRARY OS2386.LIB
