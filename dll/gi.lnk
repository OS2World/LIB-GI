FORMAT OS2 FLAT DLL INITINSTANCE
NAME DLL\GI.DLL
OPTION MAP=DLL\GI.MAP
OPTION DESCRIPTION '@#OS2World:1.01#@GI 1.01 - Game Interface by Roman Fischer (Open Watcom 2)'
OPTION MANYAUTODATA
OPTION STACK=32768
OPTION VERSION=2.0
EXPORT _error.1=_error RESIDENT
EXPORT _numplayer.2=_numplayer RESIDENT
EXPORT _fip.3=_fip RESIDENT
EXPORT _GIInitialize.4=GIINITIALIZE RESIDENT
EXPORT _GIGetDirection.5=GIGETDIRECTION RESIDENT
EXPORT _InitFip.6=INITFIP RESIDENT
EXPORT _DelFip.7=DELFIP RESIDENT
EXPORT _Save.8=SAVE RESIDENT
EXPORT _GIGetThreshold.9=GIGETTHRESHOLD RESIDENT
FILE DLL\GI.OBJ
LIBRARY CLIB3R.LIB
LIBRARY OS2386.LIB
