FORMAT OS2 FLAT DLL INITINSTANCE
NAME DLL\JOY.DLL
OPTION MAP=DLL\JOY.MAP
OPTION DESCRIPTION '@#OS2World:1.01#@JOY 1.01 - GI joystick strategy by Roman Fischer (Open Watcom 2)'
OPTION MANYAUTODATA
OPTION STACK=32768
OPTION VERSION=2.0
EXPORT _GetDataSize.1=GETDATASIZE RESIDENT
EXPORT _InitializeDLL.2=INITIALIZEDLL RESIDENT
EXPORT _Name.3=NAME RESIDENT
EXPORT _ConfigDLL.4=CONFIGDLL RESIDENT
EXPORT _Threshold.5=THRESHOLD RESIDENT
EXPORT _Direction.6=DIRECTION RESIDENT
FILE DLL\JOY.OBJ
LIBRARY CLIB3R.LIB
LIBRARY OS2386.LIB
